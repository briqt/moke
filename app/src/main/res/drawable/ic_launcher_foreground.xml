<?xml version="1.0" encoding="utf-8"?>
<!-- Moke 图标前景：终端提示符 `>_`（墨玉尖括号 + 墨白光标）。
     此前是书法「M」，辨识不出这是终端工具（反馈"像笔记软件"），改用 shell 提示符这一通用符号。
     viewport 1024；整组横向居中于 512，落在自适应图标安全区内。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- 尖括号（墨玉，主色强调——较主题绿更浓） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3AD9A8"
        android:strokeWidth="104"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M334,372 L487,516 L334,660" />
    <!-- 光标（墨白横杠，与尖括号收笔同高） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#EAF1F6"
        android:strokeWidth="104"
        android:strokeLineCap="round"
        android:pathData="M578,660 L690,660" />
</vector>
